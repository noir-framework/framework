{
    "name": "noirapi/framework",
    "description": "Small PHP 8.4 web framework: FastRoute routing, Latte views, noirapi/database models, Tracy debugging.",
    "type": "library",
    "keywords": ["php", "framework", "latte", "fast-route", "tracy"],
    "homepage": "https://github.com/noir-framework/framework",
    "license": "MIT",
    "authors": [
        {
            "name": "deba12",
            "email": "int986@gmail.com",
            "homepage": "https://github.com/deba12",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/noir-framework/framework/issues",
        "source": "https://github.com/noir-framework/framework"
    },
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-posix": "*",
        "bacon/bacon-qr-code": "^2.0.8 || ^3.0",
        "html2text/html2text": "^4.3",
        "laminas/laminas-permissions-acl": "^2.10",
        "latte/latte": "^3.1",
        "nette/neon": "^3.4",
        "nette/schema": "^1.3",
        "nette/utils": "^4.0",
        "nikic/fast-route": "^1.3",
        "nikic/php-parser": "^5.0",
        "noirapi/database": "^5.0",
        "php-curl-class/php-curl-class": "^9.1 || ^10.0 || ^11.0",
        "robthree/twofactorauth": "^2.0 || ^3.0",
        "symfony/mailer": "^7.0 || ^8.0",
        "tracy/tracy": "^2.10"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "rector/rector": "^2.2"
    },
    "suggest": {
        "ext-memcached": "Memcached session handler (session.driver: memcached)",
        "ext-pdo_mysql": "MySQL / MariaDB models and the MySQL session handler",
        "ext-pdo_sqlite": "SQLite models and the SQLite session handler",
        "ext-swoole": "Serving the app with swoole.php and Lib\\Tasks",
        "digitickets/lalit": "XML responses (Response::TYPE_XML)",
        "rector/rector": "Automated upgrades with Rector/config/*.php (see UPGRADE.md)"
    },
    "autoload": {
        "psr-4": {
            "Noirapi\\": ""
        },
        "exclude-from-classmap": [
            "/bin/",
            "/docs/",
            "/Templates/",
            "/tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Noirapi\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/noirapi"
    ],
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/noir-framework/database"
        }
    ],
    "minimum-stability": "beta",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
