{* Default magic-link email. Override with app/templates/magic-link.latte. *}
<!DOCTYPE html>
<html>
<body style="font-family: sans-serif; line-height: 1.5; color: #222;">
    <p>Hello{if $name !== ''} {$name}{/if},</p>
    <p>Use this link to sign in. It works once and expires in {$ttlMinutes} minutes:</p>
    <p><a href="{$magicUrl}" style="display: inline-block; padding: 10px 18px; background: #0d6efd; color: #fff; text-decoration: none; border-radius: 4px;">Sign in</a></p>
    <p style="font-size: 13px; color: #666;">If the button doesn't work, copy this address into your browser:<br>{$magicUrl}</p>
    <p style="font-size: 13px; color: #666;">If you didn't ask for this email, you can ignore it.</p>
</body>
</html>
