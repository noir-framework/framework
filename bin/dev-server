#!/usr/bin/env bash
#
# Starts/stops PHP's built-in dev server in the background for a NoirAPI
# app, routed through noirapi/bin/router.php so static assets under
# htdocs/ (CSS/JS/images) are served directly instead of falling through
# to the app router and coming back as HTML.
#
# Usage: noirapi/bin/dev-server [start|stop|restart|status] [--port N] [--host H] [--config NAME]
#        vendor/bin/noirapi dev-server ...   (Composer installs)
#
# Project root is NOIRAPI_ROOT when set (bin/noirapi sets it), otherwise two
# levels above this script (<root>/noirapi/bin/).
# Pid file lives at <root>/temp/dev-server.pid, log at <root>/logs/dev-server.log
# (alongside Tracy's own logs, both dirs already gitignored wholesale).
#
# Optional <root>/dev-server.ini: one php.ini setting per line (key=value, # comments allowed),
# passed to php -S as -d options, e.g. upload_max_filesize=2G for local upload testing.
# (php -S ignores .user.ini, and -c would replace the whole system php.ini.)
#
# PHP_CLI_SERVER_WORKERS spawns multiple worker processes so the built-in dev
# server can handle concurrent requests — without it, a single long-poll (e.g.
# an OCR worker container's GET /api/v1/ocr/worker/next) blocks every other
# request until it resolves, making the whole site feel hung.

set -euo pipefail

BIN_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
ROOT="${NOIRAPI_ROOT:-$(cd "$BIN_DIR/../.." && pwd)}"
mkdir -p "$ROOT/temp" "$ROOT/logs"
PID_FILE="$ROOT/temp/dev-server.pid"
LOG_FILE="$ROOT/logs/dev-server.log"
SERVER_WORKERS="${PHP_CLI_SERVER_WORKERS:-4}"

HOST="localhost"
PORT="8000"
CONFIG_NAME="${CONFIG:-default}"
ACTION="start"

while [[ $# -gt 0 ]]; do
    case "$1" in
        start|stop|restart|status) ACTION="$1"; shift ;;
        --port) PORT="$2"; shift 2 ;;
        --host) HOST="$2"; shift 2 ;;
        --config) CONFIG_NAME="$2"; shift 2 ;;
        *) echo "Unknown argument: $1" >&2; exit 1 ;;
    esac
done

is_running() {
    [[ -f "$PID_FILE" ]] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null
}

start_server() {
    if is_running; then
        echo "Dev server already running (pid $(cat "$PID_FILE")) at http://$HOST:$PORT"
        return 0
    fi
    cd "$ROOT"
    local ini_opts=()
    if [[ -f "$ROOT/dev-server.ini" ]]; then
        while IFS= read -r line || [[ -n "$line" ]]; do
            line="${line%%#*}"
            line="$(echo "$line" | xargs | sed -E 's/[[:space:]]*=[[:space:]]*/=/')"
            [[ -n "$line" ]] && ini_opts+=(-d "$line")
        done < "$ROOT/dev-server.ini"
    fi
    CONFIG="$CONFIG_NAME" PHP_CLI_SERVER_WORKERS="$SERVER_WORKERS" NOIRAPI_ROOT="$ROOT" \
        nohup php "${ini_opts[@]}" -S "$HOST:$PORT" -t htdocs "$BIN_DIR/router.php" \
        > "$LOG_FILE" 2>&1 &
    disown
    echo $! > "$PID_FILE"
    sleep 0.3
    if is_running; then
        echo "Dev server started at http://$HOST:$PORT (pid $(cat "$PID_FILE"), log: $LOG_FILE, CONFIG=$CONFIG_NAME)"
    else
        echo "Dev server failed to start - check $LOG_FILE" >&2
        exit 1
    fi
}

stop_server() {
    if is_running; then
        local pid
        pid="$(cat "$PID_FILE")"
        kill "$pid"
        rm -f "$PID_FILE"
        echo "Stopped dev server (was pid $pid)."
    else
        echo "Dev server is not running."
        rm -f "$PID_FILE"
    fi
}

status_server() {
    if is_running; then
        echo "Dev server running (pid $(cat "$PID_FILE")) at http://$HOST:$PORT"
    else
        echo "Dev server is not running."
    fi
}

case "$ACTION" in
    start) start_server ;;
    stop) stop_server ;;
    restart) stop_server; start_server ;;
    status) status_server ;;
esac
