#!/usr/bin/env bash
#
# Single Composer entry point for the framework's tools:
#   vendor/bin/noirapi dev-server [start|stop|restart|status] [--port N] [--host H] [--config NAME]
#   vendor/bin/noirapi latte-lint <path> [<path>...] [--debug]
#   vendor/bin/noirapi latte-check [--strict] [--no-controller-check] ...
#   vendor/bin/noirapi <command> [args...]   cache:clear, routes:list, config:check, make:*, ... (bin/console.php)
#
# It only works out the project root and exports it as NOIRAPI_ROOT; the tools
# themselves are the same scripts submodule apps call as noirapi/bin/<tool>.
# Root: NOIRAPI_ROOT if already set, else the parent of Composer's vendor dir
# (COMPOSER_RUNTIME_BIN_DIR is <root>/vendor/bin), else the current directory.

set -euo pipefail

BIN_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

if [[ -z "${NOIRAPI_ROOT:-}" ]]; then
    if [[ -n "${COMPOSER_RUNTIME_BIN_DIR:-}" ]]; then
        NOIRAPI_ROOT="$(cd "$COMPOSER_RUNTIME_BIN_DIR/../.." && pwd)"
    else
        NOIRAPI_ROOT="$(pwd)"
    fi
fi
export NOIRAPI_ROOT

[[ $# -gt 0 ]] || exec php "$BIN_DIR/console.php" list
command="$1"

case "$command" in
    dev-server) shift; exec "$BIN_DIR/dev-server" "$@" ;;
    latte-lint) shift; exec php "$BIN_DIR/latte-lint" "$@" ;;
    latte-check) shift; exec php "$BIN_DIR/latte-check.php" "$@" ;;
    *) exec php "$BIN_DIR/console.php" "$@" ;;
esac
