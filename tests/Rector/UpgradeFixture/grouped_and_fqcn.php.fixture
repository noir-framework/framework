<?php

use Noirapi\Database\{Database, Connection};
use Noirapi\Database\SQL\Expression as Expr;
use Other\Database\Thing;

function make(\PDO $pdo): \Noirapi\Database\Database
{
    /** @var Expr $x */
    return new \Noirapi\Database\Database(Connection::fromPDO($pdo));
}
