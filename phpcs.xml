<?xml version="1.0"?>
<ruleset name="noirapi">
    <description>Coding standard for the NoirAPI framework (PSR-12).</description>

    <file>.</file>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/temp/*</exclude-pattern>
    <!-- Rector fixtures are input/expected-output pairs, not code we format -->
    <exclude-pattern>tests/Rector/*Fixture/*</exclude-pattern>
    <!-- Swoole support is on hold (keep or drop is undecided), so swoole.php stays untouched
         until then; it only has whitespace findings. Remove this line when that's decided. -->
    <exclude-pattern>swoole.php</exclude-pattern>

    <arg name="basepath" value="." />
    <arg name="colors" />
    <arg name="extensions" value="php" />
    <arg value="np" />

    <rule ref="PSR12" />
</ruleset>
